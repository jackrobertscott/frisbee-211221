# Copy to `.env` (or `.env.production` when NODE_ENV=production).
# Same variables as server/.env, except MONGODB_URI/MONGODB_DB -> SQLITE_PATH.

PORT="5000"
APP_NAME="Marlow Street"
URL_CLIENT="http://localhost:3000"
# SQLite database file; parent directories are created on start.
SQLITE_PATH="data/frisbee.sqlite"
JWT_SECRET="SuperSecret123"
SES_ACCESS_KEY_ID=""
SES_SECRET_ACCESS_KEY=""
SES_REGION="us-east-1"
SES_FROM_EMAIL=""
# Optional (defaults shown)
# SESSION_TTL_DAYS="90"
# NODE_ENV="production"            # production mode: SES email, redacted errors, startup retries
# GAMEDAY_IMPORT_SCHEDULER_DISABLED="false"   # 1/true/yes/on disables the scheduler

# GameDay exporter options (read by the GameDay export code, as in TS)
# GAMEDAY_DEBUG, GAMEDAY_DEBUG_DIR, GAMEDAY_HEADLESS / HEADLESS,
# GAMEDAY_BROWSER_CHANNEL / BROWSER_CHANNEL,
# GAMEDAY_BROWSER_EXECUTABLE_PATH / PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH / CHROME_PATH,
# GAMEDAY_REPORT_ID / REPORT_ID, GAMEDAY_TIMEOUT_MS / REPORT_TIMEOUT_MS,
# GAMEDAY_PROCESS_TIMEOUT_MS, GAMEDAY_FIELDS / FIELD_IDS, GAMEDAY_HEADERS / OUTPUT_HEADERS,
# GAMEDAY_GENDER_FIELD / GENDER_FIELD_ID, GAMEDAY_RECORD_FILTER / RECORD_FILTER,
# GAMEDAY_NORMALIZE_HEADERS / NORMALIZE_HEADERS
